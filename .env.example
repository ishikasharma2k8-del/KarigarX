# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INSTAGRAM / META GRAPH API CONNECTOR (OPTIONAL)
# To enable automated Instagram publishing for verified artisan listings:
# 1. Create a Meta for Developers App (https://developers.facebook.com) with Instagram Graph API.
# 2. Connect your Instagram Professional / Business Account to a verified Facebook Page.
# 3. Generate a User or Page Access Token with permissions:
#    - instagram_basic
#    - instagram_content_publish
#    - pages_show_list
# 4. Supply your Instagram Business Account ID and Access Token below.
# Keep these server-side only. Never expose these credentials to the client.
INSTAGRAM_BUSINESS_ACCOUNT_ID="YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID"
INSTAGRAM_ACCESS_TOKEN="YOUR_INSTAGRAM_ACCESS_TOKEN"

# Optional: Meta Graph API Version (defaults to v19.0)
INSTAGRAM_GRAPH_API_VERSION="v19.0"

